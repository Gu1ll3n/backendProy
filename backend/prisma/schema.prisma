generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String
  createdAt DateTime @default(now())

  appointments Appointment[] @relation("DoctorAppointments")
  auditLogs    AuditLog[]
  accessLogs   AccessLog[]
}

model Patient {
  id             Int       @id @default(autoincrement())
  firstName      String
  lastName       String
  ci             String    @unique

  phone          String?
  address        String?
  gender         String?
  birthDate      DateTime?

  email          String?
  bloodType      String?
  allergies      String?
  medicalHistory String?

  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  appointments Appointment[]
}

model Appointment {
  id          Int       @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  scheduledAt DateTime
  status      String
  reason      String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User    @relation("DoctorAppointments", fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  detail    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  ip        String
  userAgent String?
  event     String
  detail    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}